[Unit]
Description=Gunicorn instance to serve LMS
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/lms/lms
ExecStart=/home/ubuntu/lms/deployment_ubuntu/venv/bin/gunicorn \
          --access-logfile - \
          --workers 3 \
          --bind unix:/home/ubuntu/lms/lms.sock \
          config.wsgi:application

[Install]
WantedBy=multi-user.target
